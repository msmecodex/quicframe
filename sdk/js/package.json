{
  "name": "@quicframe/client",
  "version": "0.1.0",
  "description": "Browser WebTransport client for the QuicFrame QUIC-native API framework",
  "type": "module",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "keywords": [
    "quic",
    "webtransport",
    "msgpack",
    "rpc",
    "binary"
  ],
  "license": "MIT"
}
